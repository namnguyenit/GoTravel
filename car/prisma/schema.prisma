generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. Operator (Nhà xe chính thức)
// ============================================================================
model Operator {
  id             String         @id @default(uuid())
  userId         String         @unique @map("user_id") // ID tài khoản chủ nhà xe (từ Identity Service)
  name           String         // Tên pháp nhân nhà xe (đồng bộ từ Identity KYC)
  status         OperatorStatus @default(ACTIVE)
  displayName    String?        @map("display_name")
  logoUrl        String?        @map("logo_url")
  contactPhone   String?        @map("contact_phone")
  contactAddress String?        @map("contact_address")
  description    String?        @map("description")

  cars      Car[]
  routes    Route[]
  trips     Trip[]
  staff     OperatorStaff[]
  stops     OperatorStop[]
  seatClasses OperatorSeatClass[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("operators")
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

model OperatorSeatClass {
  id String @id @default(uuid())
  operatorId String @map("operator_id")
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  code String @db.VarChar(32)
  label String @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([operatorId, code])
  @@map("operator_seat_classes")
}

model OperatorStaff {
  id           String   @id @default(uuid())
  operatorId   String   @map("operator_id")
  operator     Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id")
  canSellCash  Boolean  @default(false) @map("can_sell_cash")
  canCheckIn   Boolean  @default(false) @map("can_check_in")
  canManageTrip Boolean @default(false) @map("can_manage_trip")
  canCloseShift Boolean @default(false) @map("can_close_shift")
  tripIds      String[] @default([]) @map("trip_ids")
  active       Boolean  @default(true)
  assignedBy   String   @map("assigned_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([operatorId, userId])
  @@map("operator_staff")
}

// ============================================================================
// 1b. OperatorApplication (Đơn đăng ký trở thành Nhà xe)
// ============================================================================
model OperatorApplication {
  id           String                    @id @default(uuid())
  userId       String                    @map("user_id") // ID người dùng nộp đơn
  name         String                                    // Tên nhà xe xin đăng ký
  phone        String                                    // Số điện thoại liên hệ
  address      String                                    // Địa chỉ trụ sở
  status       OperatorApplicationStatus @default(PENDING)// PENDING, APPROVED, REJECTED, CANCELLED
  rejectReason String?                   @map("reject_reason") // Lý do từ chối (nếu có)

  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  @@map("operator_applications")
}

enum OperatorApplicationStatus {
  PENDING   // Đang chờ Admin duyệt
  APPROVED  // Đã được Admin phê duyệt
  REJECTED  // Bị Admin từ chối
  CANCELLED // Người dùng tự hủy đơn
}

// ============================================================================
// 2. Car (Xe khách)
// ============================================================================
model Car {
  id           String     @id @default(uuid())
  operatorId   String     @map("operator_id")
  operator     Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name         String                                    // Tên xe (VD: Xe 01, Limousine VIP)
  type         CarType    @default(SLEEPER)             // Loại xe (Giường nằm, Limousine, Ghế ngồi)
  status       CarStatus  @default(ACTIVE)              // Trạng thái xe (Đang hoạt động, Bảo trì/Hỏng, Tạm ngừng)
  licensePlate String     @unique @map("license_plate") // Biển số xe
  totalSeats   Int        @map("total_seats")           // Tổng số ghế
  deletedAt    DateTime?  @map("deleted_at") // Hide from fleet; preserve trip and ticket history.

  trips        Trip[]
  seatTemplates SeatTemplate[]

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([operatorId, deletedAt])
  @@map("cars")
}

model SeatTemplate {
  id        String   @id @default(uuid())
  carId     String   @map("car_id")
  car       Car      @relation(fields: [carId], references: [id], onDelete: Restrict)
  code      String   @db.VarChar(32)
  level     Int      @default(1)
  seatClass String   @default("STANDARD") @map("seat_class") @db.VarChar(32)
  row       Int      @default(0)
  column    Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([carId, code])
  @@map("seat_templates")
}

enum CarType {
  SLEEPER   // Xe giường nằm
  LIMOUSINE // Xe Limousine
  SEAT      // Xe ghế ngồi
}

enum CarStatus {
  ACTIVE      // Hoạt động
  MAINTENANCE // Đang bảo trì / hỏng hóc
  INACTIVE    // Tạm khóa / ngưng sử dụng
}

// ============================================================================
// 3. Route (Tuyến xe khách)
// ============================================================================
model Route {
  id          String      @id @default(uuid())
  operatorId  String      @map("operator_id")
  operator    Operator    @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  origin      String      // Điểm khởi hành (VD: Hà Nội)
  destination String      // Điểm đến (VD: Đà Nẵng)
  status      RouteStatus @default(ACTIVE)
  deletedAt   DateTime?   @map("deleted_at") // Removed from the planning catalog; history keeps its FK.

  stops       RouteStop[]
  trips       Trip[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([operatorId, deletedAt])
  @@map("routes")
}

enum RouteStatus {
  ACTIVE   // Đang hoạt động
  INACTIVE // Tạm khóa / Ngừng khai thác
}

// ============================================================================
// 4. RouteStop (Điểm dừng / Đón trả trên tuyến)
// ============================================================================
model RouteStop {
  id             String        @id @default(uuid())
  routeId        String        @map("route_id")
  route          Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  operatorStopId String?       @map("operator_stop_id")
  operatorStop   OperatorStop? @relation(fields: [operatorStopId], references: [id], onDelete: SetNull)
  name           String        // Tên điểm dừng (VD: Bến xe Nước Ngầm, Trạm dừng Phủ Lý)
  address        String?
  province       String?
  order          Int           // Thứ tự điểm dừng trên tuyến (0, 1, 2, 3...)

  // Quan hệ với Ticket (Điểm đón và điểm trả)
  pickUpTickets  Ticket[] @relation("PickUpPoint")
  dropOffTickets Ticket[] @relation("DropOffPoint")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([routeId, order]) // Thứ tự điểm dừng trên cùng 1 tuyến phải là duy nhất
  @@map("route_stops")
}

// ============================================================================
// 4b. OperatorStop (Danh mục điểm dừng nhà xe)
// ============================================================================
model OperatorStop {
  id         String      @id @default(uuid())
  operatorId String      @map("operator_id")
  operator   Operator    @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name       String
  address    String
  province   String
  active     Boolean     @default(true)

  routeStops RouteStop[]

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([operatorId, active])
  @@map("operator_stops")
}

// ============================================================================
// 5. Trip (Chuyến xe cụ thể)
// ============================================================================
model Trip {
  id            String     @id @default(uuid())
  operatorId    String     @map("operator_id")
  operator      Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  routeId       String     @map("route_id")
  route         Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  carId         String     @map("car_id")
  car           Car        @relation(fields: [carId], references: [id], onDelete: Cascade)
  
  departureTime DateTime   @map("departure_time") // Giờ xuất bến
  arrivalTime   DateTime   @map("arrival_time")   // Giờ đến dự kiến
  pricePerSeat  Float      @map("price_per_seat") // Giá vé cơ bản trên mỗi ghế (VNĐ)
  priceVnd      Decimal?   @map("price_vnd") @db.Decimal(18, 0)
  searchPriceVnd Decimal? @map("search_price_vnd") @db.Decimal(18, 0)
  offerListingId String?   @map("offer_listing_id")
  status        TripStatus @default(DRAFT)
  saleSnapshot  Json?      @map("sale_snapshot")
  classPrices   Json?      @map("class_prices")
  stopOverrides Json?      @map("stop_overrides")
  publishAttempts Int     @default(0) @map("publish_attempts")
  publishRetryAt DateTime? @map("publish_retry_at")
  publishError  String?   @map("publish_error")
  inventorySyncVersion Int @default(0) @map("inventory_sync_version")
  inventorySyncedVersion Int @default(0) @map("inventory_synced_version")
  completionSyncedAt DateTime? @map("completion_synced_at")

  tickets       Ticket[]
  issuedTickets IssuedTicket[]
  cancellation TripCancellation?

  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([carId, departureTime, arrivalTime]) // Index phục vụ query kiểm tra trùng lặp lịch chạy xe
  @@map("trips")
}

model TripCancellation {
  tripId       String   @id @map("trip_id")
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  requestedBy  String   @map("requested_by")
  reason       String   @db.VarChar(500)
  status       String   @default("PROCESSING") @db.VarChar(32)
  pendingOrders Int     @default(0) @map("pending_orders")
  pendingRefunds Int    @default(0) @map("pending_refunds")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("trip_cancellations")
}

enum TripStatus {
  DRAFT
  PUBLISHING
  ON_SALE
  STOP_SALE
  SCHEDULED // Sắp chạy
  DEPARTED  // Đã xuất bến
  COMPLETED // Hoàn thành
  CANCELLED // Hủy chuyến
}

model IssuedTicket {
  id            String             @id @default(uuid())
  orderId       String             @map("order_id")
  orderItemId   String             @unique @map("order_item_id")
  tripId        String             @map("trip_id")
  trip          Trip               @relation(fields: [tripId], references: [id], onDelete: Restrict)
  seatId        String             @map("seat_id")
  passengerName String             @map("passenger_name")
  pickupStopId  String             @map("pickup_stop_id")
  dropoffStopId String             @map("dropoff_stop_id")
  tokenHash     String             @unique @map("token_hash")
  status        IssuedTicketStatus @default(ACTIVE)
  tokenGeneration Int             @default(1) @map("token_generation")
  revision      Int                @default(1)
  checkedInAt   DateTime?          @map("checked_in_at")
  checkedInBy   String?            @map("checked_in_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  amendments    TransportTicketAmendment[]
  itemOperations TransportItemOperation[]

  @@index([tripId, status])
  @@index([orderId])
  @@map("issued_tickets")
}

model TransportTicketAmendment {
  commandId   String       @id @map("command_id")
  ticketId    String       @map("ticket_id")
  ticket      IssuedTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  orderItemId String       @map("order_item_id")
  orderId     String       @map("order_id")
  revision    Int          @map("revision")
  payloadHash String       @map("payload_hash")
  result      Json         @map("result")
  appliedAt   DateTime     @default(now()) @map("applied_at")

  @@index([ticketId])
  @@index([orderItemId])
  @@map("transport_ticket_amendments")
}

enum IssuedTicketStatus {
  ACTIVE
  VOID
  CHECKED_IN
  NO_SHOW
}

// ============================================================================
// 6. Ticket (Vé xe đã đặt)
// ============================================================================
model Ticket {
  id             String       @id @default(uuid())
  userId         String       @map("user_id") // ID người dùng đặt vé (từ Identity Service)
  tripId         String       @map("trip_id")
  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  pickUpPointId  String       @map("pick_up_point_id")
  pickUpPoint    RouteStop    @relation("PickUpPoint", fields: [pickUpPointId], references: [id])
  dropOffPointId String       @map("drop_off_point_id")
  dropOffPoint   RouteStop    @relation("DropOffPoint", fields: [dropOffPointId], references: [id])

  seatNumber     String       @map("seat_number") // Số ghế (VD: A01, A02, B05)
  price          Float        // Giá vé thực tế lưu lại tại thời điểm đặt vé
  status         TicketStatus @default(BOOKED)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([tripId, seatNumber]) // Business Rule: Một ghế chỉ được đặt duy nhất 1 lần trong cùng 1 Trip
  @@map("tickets")
}

enum TicketStatus {
  BOOKED    // Đã đặt / giữ chỗ
  PAID      // Đã thanh toán
  CANCELLED // Đã hủy vé
}

model TransportQuoteRecord {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  version   String
  hash      String
  payload   Json
  expiresAt DateTime @map("expires_at")
  orderId   String?  @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("transport_quotes")
}

model TransportAudit {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  tripId    String?  @map("trip_id")
  action    String
  detail    Json
  createdAt DateTime @default(now()) @map("created_at")
  @@index([tripId, createdAt])
  @@map("transport_audit")
}

model TransportItemOperation {
 id String @id
 ticketId String @map("ticket_id")
 ticket IssuedTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
 requestHash String @map("request_hash")
 status String
 plan Json
 previousTicket Json? @map("previous_ticket")
 result Json?
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([ticketId,status], map:"transport_item_operations_ticket_status_idx")
 @@map("transport_item_operations")
}
