PORT=3333
SERVICE_BIND_HOST=127.0.0.1
GOCAR_ENABLED=false
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/car?schema=public
INTERNAL_SERVICE_TOKEN=replace-with-the-shared-internal-service-token
TICKET_SIGNING_KEY=replace-with-at-least-32-random-bytes
IDENTITY_INTERNAL_URL=http://127.0.0.1:8080
CATALOG_INTERNAL_URL=http://127.0.0.1:8082
INVENTORY_INTERNAL_URL=http://127.0.0.1:8083
CART_INTERNAL_URL=http://127.0.0.1:8084

# Minutes after departure before NO_SHOW is allowed.
GOCAR_NO_SHOW_MINUTES=120
# Enable in the release environment after configuring ALL receivers/callers.
TRANSPORT_INTERNAL_AUTH_REQUIRED=false
# JSON objects of distinct random secrets (minimum 32 characters); never commit real tokens.
TRANSPORT_INTERNAL_CALLERS={}
# TRANSPORT_INTERNAL_TOKENS={"catalog":"...","inventory":"...","cart":"..."}
