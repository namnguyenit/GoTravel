GATEWAY_PORT=5555
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_CONFIG_DB=./.data/gateway.sqlite
# Optional: one-time import of routes from the former JSON store.
# GATEWAY_ROUTES_FILE=./.data/routes.json
# Add trusted upstream hostnames when deploying services beyond loopback.
GATEWAY_UPSTREAM_HOSTS=localhost,127.0.0.1,[::1]
TRUST_PROXY=loopback
IDENTITY_SERVICE_URL=http://localhost:8080
MEDIA_SERVICE_URL=http://localhost:5001
CATALOG_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083
CART_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
SEARCH_SERVICE_URL=http://localhost:8086
CAR_SERVICE_URL=http://localhost:3333
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-shared-secret
CSRF_SECRET=replace-with-a-distinct-random-secret-of-at-least-32-bytes
AUTH_COOKIE_DOMAIN=nonnet123.io.vn
AUTH_ALLOWED_ORIGINS=https://gostay.nonnet123.io.vn,https://auth.nonnet123.io.vn
